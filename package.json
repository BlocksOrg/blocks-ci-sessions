{
  "name": "@blocks/ci-sessions",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that runs a Blocks agent session from CI",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "all": "npm run lint && npm run type-check && npm run test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/http-client": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "type": "module"
}
